{% extends 'medical/layout.html.twig' %}

{% block title %}Вхід{% endblock %}

{% block content %}
    <h1>Вхід</h1>

    <form method="post" action="{{ path('login') }}">
        <label for="email">Пошта</label>
        <input id="email" type="email" name="email" required value="{{ email }}">

        <label for="password">Пароль</label>
        <input id="password" type="password" name="password" required>

        <p><button class="btn" type="submit">Увійти</button></p>
    </form>

    <p>Немає акаунта? <a href="{{ path('register') }}">Зареєструватися</a></p>
{% endblock %}