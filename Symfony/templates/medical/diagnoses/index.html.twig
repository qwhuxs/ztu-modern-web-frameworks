{% extends 'medical/layout.html.twig' %}

{% block title %}Діагнози{% endblock %}

{% block content %}
    {% set user = app.request.attributes.get('user') %}
    <h1>Діагнози</h1>
    {% if user.hasRole('manager') %}
        <a class="btn" href="{{ path('diagnosis_new') }}">Додати діагноз</a>
    {% endif %}

    <form method="get" class="filters">
        <div>
            <label for="id">ID</label>
            <input id="id" type="number" min="1" name="id" value="{{ app.request.query.get('id') }}">
        </div>
        <div>
            <label for="appointment_id">Прийом</label>
            <select id="appointment_id" name="appointment_id">
                <option value="">Усі</option>
                {% for appointment in appointments %}
                    <option value="{{ appointment.id }}" {% if app.request.query.get('appointment_id') == appointment.id %}selected{% endif %}>{{ appointment.appointmentAt|date('d.m.Y H:i') }}, {{ appointment.patient.lastName }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="name">Назва</label>
            <input id="name" name="name" value="{{ app.request.query.get('name') }}">
        </div>
        <div>
            <label for="description">Опис</label>
            <input id="description" name="description" value="{{ app.request.query.get('description') }}">
        </div>
        {% include 'medical/_filter_actions.html.twig' %}
    </form>

    <table>
        <tr><th>ID</th><th>Назва</th><th>Опис</th><th>Прийом</th><th>Дії</th></tr>
        {% for diagnosis in pagination.items %}
            <tr>
                <td>{{ diagnosis.id }}</td>
                <td>{{ diagnosis.name }}</td>
                <td>{{ diagnosis.description }}</td>
                <td>{{ diagnosis.appointment.appointmentAt|date('d.m.Y H:i') }}, {{ diagnosis.appointment.patient.lastName }}</td>
                <td class="actions">
                    {% if user.hasRole('manager') %}
                        <a class="btn" href="{{ path('diagnosis_edit', {id: diagnosis.id}) }}">Змінити</a>
                    {% endif %}
                    {% if user.hasRole('admin') %}
                        <form method="post" action="{{ path('diagnosis_delete', {id: diagnosis.id}) }}">
                            <button class="btn btn-danger" type="submit">Видалити</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Записів не знайдено.</td></tr>
        {% endfor %}
    </table>

    {% include 'medical/_pagination.html.twig' %}
{% endblock %}