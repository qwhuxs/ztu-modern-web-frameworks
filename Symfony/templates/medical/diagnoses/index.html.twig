{% extends 'medical/layout.html.twig' %}

{% block title %}Діагнози{% endblock %}

{% block content %}
    <h1>Діагнози</h1>
    <a class="btn" href="{{ path('diagnosis_new') }}">Додати діагноз</a>

    <table>
        <tr><th>Назва</th><th>Опис</th><th>Прийом</th><th>Дії</th></tr>
        {% for diagnosis in diagnoses %}
            <tr>
                <td>{{ diagnosis.name }}</td>
                <td>{{ diagnosis.description }}</td>
                <td>{{ diagnosis.appointment.appointmentAt|date('d.m.Y H:i') }}, {{ diagnosis.appointment.patient.lastName }}</td>
                <td class="actions">
                    <a class="btn" href="{{ path('diagnosis_edit', {id: diagnosis.id}) }}">Змінити</a>
                    <form method="post" action="{{ path('diagnosis_delete', {id: diagnosis.id}) }}">
                        <button class="btn btn-danger" type="submit">Видалити</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="4">Записів ще немає.</td></tr>
        {% endfor %}
    </table>
{% endblock %}