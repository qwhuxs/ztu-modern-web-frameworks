{% extends 'medical/layout.html.twig' %}

{% block title %}Лікарі{% endblock %}

{% block content %}
    {% set user = app.request.attributes.get('user') %}
    <h1>Лікарі</h1>
    {% if user.hasRole('manager') %}
        <a class="btn" href="{{ path('doctor_new') }}">Додати лікаря</a>
    {% endif %}

    <form method="get" class="filters">
        <div>
            <label for="id">ID</label>
            <input id="id" type="number" min="1" name="id" value="{{ app.request.query.get('id') }}">
        </div>
        <div>
            <label for="last_name">Прізвище</label>
            <input id="last_name" name="last_name" value="{{ app.request.query.get('last_name') }}">
        </div>
        <div>
            <label for="first_name">Ім'я</label>
            <input id="first_name" name="first_name" value="{{ app.request.query.get('first_name') }}">
        </div>
        <div>
            <label for="specialty">Спеціальність</label>
            <input id="specialty" name="specialty" value="{{ app.request.query.get('specialty') }}">
        </div>
        <div>
            <label for="phone">Телефон</label>
            <input id="phone" name="phone" value="{{ app.request.query.get('phone') }}">
        </div>
        {% include 'medical/_filter_actions.html.twig' %}
    </form>

    <table>
        <tr><th>ID</th><th>Прізвище та ім'я</th><th>Спеціальність</th><th>Телефон</th><th>Дії</th></tr>
        {% for doctor in pagination.items %}
            <tr>
                <td>{{ doctor.id }}</td>
                <td>{{ doctor.lastName }} {{ doctor.firstName }}</td>
                <td>{{ doctor.specialty }}</td>
                <td>{{ doctor.phone }}</td>
                <td class="actions">
                    {% if user.hasRole('manager') %}
                        <a class="btn" href="{{ path('doctor_edit', {id: doctor.id}) }}">Змінити</a>
                    {% endif %}
                    {% if user.hasRole('admin') %}
                        <form method="post" action="{{ path('doctor_delete', {id: doctor.id}) }}">
                            <button class="btn btn-danger" type="submit">Видалити</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Записів не знайдено.</td></tr>
        {% endfor %}
    </table>

    {% include 'medical/_pagination.html.twig' %}
{% endblock %}