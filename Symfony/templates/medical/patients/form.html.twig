{% extends 'medical/layout.html.twig' %}

{% block title %}Пацієнт{% endblock %}

{% block content %}
    <h1>{{ patient.id ? 'Редагування' : 'Новий запис' }}: Пацієнт</h1>

    <form method="post">
        <label for="last_name">Прізвище</label>
        <input id="last_name" name="last_name" maxlength="100" required value="{{ patient.lastName }}">

        <label for="first_name">Ім'я</label>
        <input id="first_name" name="first_name" maxlength="100" required value="{{ patient.firstName }}">

        <label for="birth_date">Дата народження</label>
        <input id="birth_date" type="date" name="birth_date" required value="{{ patient.birthDate ? patient.birthDate|date('Y-m-d') }}">

        <label for="phone">Телефон</label>
        <input id="phone" name="phone" maxlength="20" required value="{{ patient.phone }}">

        <p><button class="btn" type="submit">Зберегти</button></p>
    </form>
{% endblock %}