{% extends 'medical/layout.html.twig' %}

{% block title %}Лікування{% endblock %}

{% block content %}
    <h1>{{ treatment.id ? 'Редагування' : 'Новий запис' }}: Лікування</h1>

    <form method="post">
        <label for="diagnosis_id">Діагноз</label>
        <select id="diagnosis_id" name="diagnosis_id" required>
            <option value="">Виберіть діагноз</option>
            {% for diagnosis in diagnoses %}
                <option value="{{ diagnosis.id }}" {% if treatment.diagnosis and treatment.diagnosis.id == diagnosis.id %}selected{% endif %}>
                    {{ diagnosis.name }}, пацієнт: {{ diagnosis.appointment.patient.lastName }}
                </option>
            {% endfor %}
        </select>

        <label for="prescription">Призначення</label>
        <textarea id="prescription" name="prescription" rows="3" required>{{ treatment.prescription }}</textarea>

        <label for="start_date">Дата початку</label>
        <input id="start_date" type="date" name="start_date" required value="{{ treatment.startDate ? treatment.startDate|date('Y-m-d') }}">

        <label for="end_date">Дата завершення</label>
        <input id="end_date" type="date" name="end_date" value="{{ treatment.endDate ? treatment.endDate|date('Y-m-d') }}">

        <p><button class="btn" type="submit">Зберегти</button></p>
    </form>
{% endblock %}