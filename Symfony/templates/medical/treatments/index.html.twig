{% extends 'medical/layout.html.twig' %}

{% block title %}Лікування{% endblock %}

{% block content %}
    <h1>Лікування</h1>
    <a class="btn" href="{{ path('treatment_new') }}">Додати лікування</a>

    <form method="get" class="filters">
        <div>
            <label for="id">ID</label>
            <input id="id" type="number" min="1" name="id" value="{{ app.request.query.get('id') }}">
        </div>
        <div>
            <label for="diagnosis_id">Діагноз</label>
            <select id="diagnosis_id" name="diagnosis_id">
                <option value="">Усі</option>
                {% for diagnosis in diagnoses %}
                    <option value="{{ diagnosis.id }}" {% if app.request.query.get('diagnosis_id') == diagnosis.id %}selected{% endif %}>{{ diagnosis.name }}, {{ diagnosis.appointment.patient.lastName }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label for="prescription">Призначення</label>
            <input id="prescription" name="prescription" value="{{ app.request.query.get('prescription') }}">
        </div>
        <div>
            <label for="start_date">Дата початку</label>
            <input id="start_date" type="date" name="start_date" value="{{ app.request.query.get('start_date') }}">
        </div>
        <div>
            <label for="end_date">Дата завершення</label>
            <input id="end_date" type="date" name="end_date" value="{{ app.request.query.get('end_date') }}">
        </div>
        {% include 'medical/_filter_actions.html.twig' %}
    </form>

    <table>
        <tr><th>ID</th><th>Призначення</th><th>Діагноз</th><th>Пацієнт</th><th>Початок</th><th>Завершення</th><th>Дії</th></tr>
        {% for treatment in pagination.items %}
            <tr>
                <td>{{ treatment.id }}</td>
                <td>{{ treatment.prescription }}</td>
                <td>{{ treatment.diagnosis.name }}</td>
                <td>{{ treatment.diagnosis.appointment.patient.lastName }}</td>
                <td>{{ treatment.startDate|date('d.m.Y') }}</td>
                <td>{{ treatment.endDate ? treatment.endDate|date('d.m.Y') }}</td>
                <td class="actions">
                    <a class="btn" href="{{ path('treatment_edit', {id: treatment.id}) }}">Змінити</a>
                    <form method="post" action="{{ path('treatment_delete', {id: treatment.id}) }}">
                        <button class="btn btn-danger" type="submit">Видалити</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">Записів не знайдено.</td></tr>
        {% endfor %}
    </table>

    {% include 'medical/_pagination.html.twig' %}
{% endblock %}